# Copy to .env and fill in. Real environment variables override .env.
# Signs the login session cookie — use a long random string.
SECRET_KEY=change-me
# The single admin account that can record and delete games.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Optional: absolute path to the SQLite file.
# Defaults to instance/tracker.db; point it at a persistent volume if your
# host has an ephemeral filesystem.
# TRACKER_DB=/data/tracker.db
